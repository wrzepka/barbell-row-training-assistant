/* ============================================ */
/*                 LOADING SCREEN               */
/* ============================================ */

QWidget#loadingScreen {
    background-color: #1C1B1B;
    border: 2px solid #313030;
}

QLabel#loadingInfo {
    font-size: 16px;
    color: #929090;
    font-weight: bold;
}

QProgressBar#loadingProgress {
    background-color: #000000;
    border: 1px solid #313030;
    border-radius: 4px;
}

QProgressBar#loadingProgress::chunk {
    background-color: #CCFF00;
    border-radius: 4px;
}

/* ============================================ */
/*                 MAIN WINDOW                  */
/* ============================================ */

QWidget#mainContainer {
    background-color: #1C1B1B;
}

/* ============================================ */
/*                    NAVBAR                    */
/* ============================================ */

QWidget#navBar {
    background-color: #000000;
    border-bottom: 2px solid #313030;
}

QWidget#navBar QPushButton {
    background-color: transparent;
    color: #929090;
    border: none;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: bold;
}

QWidget#navBar QPushButton:hover {
    background-color: #222222;
    color: white;
}

QWidget#navBar QPushButton:checked {
    color: #CCFF00;
    border-bottom: 3px solid #CCFF00;
}

/* ============================================ */
/*                  WIDOKI OGÓLNE               */
/* ============================================ */

QLabel#placeholderLabel {
    font-size: 24px;
    color: #aaaaaa;
    font-weight: bold;
}

/* ============================================ */
/*                 WIDOK TRENINGU               */
/* ============================================ */

#trainingView {
    background-color: #1a1a1a;
}

QLabel#cameraSlot {
    background-color: #1C1B1B;
    color: #ecf0f1;
    font-size: 18px;
    font-weight: bold;
    border: 2px dashed #929090;
    border-radius: 10px;
}

#cameraSlot:hover {
    border-color: #929090;
    background-color: #929090;
}

/* ============================================ */
/*                  WIDOK HISTORII              */
/* ============================================ */

#historyView {
    background-color: #1e1e1e;
}

#historyContentPage {
    background-color: #1e1e1e;
}

QScrollArea {
    background: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background: transparent;
}

QWidget#historyContainer {
    background-color: #1e1e1e;
}

QFrame#historyCard {
    background-color: #2a2a2a;
    border-radius: 8px;
    border-left: 4px solid #444444;
    margin-bottom: 2px;
}

QFrame#historyCard[expanded="true"] {
    background-color: #333333;
    border-left: 4px solid #adff2f;
}

QFrame#historyCard * {
    border: none;
    background: transparent;
}

#dateLabel {
    color: #888888;
    font-size: 11px;
}

#exerciseName {
    color: white;
    font-size: 15px;
    font-weight: bold;
}

#statsLabel {
    color: #bbbbbb;
    font-size: 13px;
}

#scoreLabel {
    font-weight: bold;
    font-size: 17px;
    margin-left: 20px;
}

.scoreHigh {
    color: #adff2f;
}

.scoreLow {
    color: #ff6666;
}

#arrowLabel {
    color: #666666;
    margin-left: 10px;
    font-size: 9px;
}

#separator {
    background-color: #444444;
    max-height: 1px;
    margin-bottom: 10px;
}

#fixTitle {
    color: #ff8888;
    font-size: 10px;
    font-weight: bold;
}

#bulletLabel {
    color: #aaaaaa;
    font-size: 12px;
    margin-left: 5px;
}

/* Scrollbar */
QScrollBar:vertical {
    background: #1e1e1e;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

#historyTitle {
    font-size: 22px;
    font-weight: bold;
    color: white;
    padding-bottom: 15px;
    border-bottom: 1px solid #333333;
}

#statsSummary {
    background-color: #2a2a2a;
    border-radius: 8px;
}

#statsTitle {
    font-size: 14px;
    font-weight: bold;
    color: #adff2f;
    border-bottom: 1px solid #444;
    padding-bottom: 5px;
}

#statsLine {
    color: #cccccc;
    font-size: 12px;
}

QFrame#performanceChartFrame {
    background-color: #2a2a2a;
    border: 4px solid white;
    border-radius: 4px;
}

/* ============================================ */
/*               WIDOK LOBBY (STRONA STARTOWA)  */
/* ============================================ */

#lobbyView {
    background-color: #1e1e1e;
}

#lobbyContentPage {
    background-color: #1e1e1e;
}

#lobbyTitle {
    font-size: 24px;
    font-weight: bold;
    color: #CCFF00;
    letter-spacing: 2px;
    margin-bottom: 10px;
    text-shadow: 0 0 8px rgba(204, 255, 0, 0.3);
}

/* Lewy panel – glassmorphism */
#lobbyLeftPanel {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(30,30,35,0.95),
                                stop:1 rgba(20,20,25,0.98));
    border-radius: 20px;
    border: 1px solid rgba(204, 255, 0, 0.2);
    box-shadow: 0 8px 20px rgba(0,0,0,0.5);
}

#systemStatus {
    font-size: 11px;
    color: #CCFF00;
    font-weight: bold;
    letter-spacing: 2px;
    text-transform: uppercase;
    background-color: rgba(204, 255, 0, 0.1);
    padding: 3px 10px;
    border-radius: 20px;
    display: inline-block;
    width: fit-content;
}

#readyLabel {
    font-size: 26px;
    font-weight: bold;
    color: white;
    margin-top: 5px;
    line-height: 1.2;
}

#programDesc {
    font-size: 13px;
    color: #b0b0b0;
    line-height: 1.5;
    margin-top: 0px;
}

#motivationLabel {
    font-size: 13px;
    color: #CCFF00;
    font-weight: bold;
    margin-top: 10px;
    text-align: center;
}

/* Prawy panel – wspólne tło */
#lobbyRightPanel {
    background-color: transparent;
}

/* Widget tygodniowy */
#weeklyWidget {
    background-color: rgba(30,30,35,0.85);
    border-radius: 20px;
    padding: 12px;
    border: 1px solid rgba(204, 255, 0, 0.15);
    backdrop-filter: blur(4px);
}

#weeklyHeader {
    font-size: 15px;
    font-weight: bold;
    color: white;
    margin-bottom: 2px;
}

#weeklyPercent {
    font-size: 12px;
    color: #CCFF00;
    margin-bottom: 8px;
    font-weight: bold;
}

/* Wykres wewnątrz – rozciąganie bez sztywnych limitów */
QChartView {
    background: transparent;
    min-height: 240px;
}

QChart {
    background: transparent;
}

QBarCategoryAxis QLabel {
    color: white;
}

QValueAxis QLabel {
    color: #cccccc;
}

/* Ostatnia sesja */
#lastSessionWidget {
    background-color: rgba(30,30,35,0.85);
    border-radius: 20px;
    padding: 12px;
    border: 1px solid rgba(204, 255, 0, 0.15);
}

#sessionTitle {
    font-size: 15px;
    font-weight: bold;
    color: white;
    margin-bottom: 6px;
}

#sessionName {
    font-size: 20px;
    font-weight: bold;
    color: #CCFF00;
}

#sessionDetail {
    font-size: 12px;
    color: #cccccc;
    margin-bottom: 12px;
}

#statBox {
    background-color: #1a1a1a;
    border-radius: 16px;
    padding: 8px;
    border: 1px solid #2c2c2c;
}

#statTitle {
    font-size: 10px;
    color: #aaaaaa;
    text-transform: uppercase;
    letter-spacing: 1px;
}

#statValue {
    font-size: 16px;
    font-weight: bold;
    color: white;
}

#viewDetailsButton {
    background-color: transparent;
    color: #CCFF00;
    border: 1px solid #CCFF00;
    border-radius: 30px;
    padding: 6px 0;
    font-size: 11px;
    font-weight: bold;
    margin-top: 8px;
    transition: all 0.2s;
}

#viewDetailsButton:hover {
    background-color: #CCFF00;
    color: black;
}

